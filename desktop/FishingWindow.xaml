<Window x:Class="BD2Fishing.Desktop.FishingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BD2 钓鱼 · 0.3.1" Width="790" Height="850" MinWidth="650" MinHeight="540" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Microsoft YaHei UI" FontSize="14" Closing="OnClosing">
<ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="连续钓鱼" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="进入钓点并面向水面，连接后开启。关闭窗口会停止自动操作。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,20"/></StackPanel>
<WrapPanel Grid.Row="1" Margin="0,0,0,20"><Button x:Name="ConnectButton" Content="连接游戏" Click="ConnectClick"/><Button x:Name="StartButton" Content="开始钓鱼" Style="{StaticResource PrimaryButton}" Click="StartClick" IsEnabled="False"/><Button x:Name="StopButton" Content="停止钓鱼" Click="StopClick" IsEnabled="False"/><Button Content="打开诊断目录" Click="OpenFolderClick"/></WrapPanel>
<Border Grid.Row="2" Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,20"><StackPanel>
<TextBlock x:Name="StatusText" Text="等待连接游戏" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
<TextBlock x:Name="ReasonText" Text="请先启动 BrownDust II，然后点击「连接游戏」。" TextWrapping="Wrap" Margin="0,8,0,12"/>
<TextBlock x:Name="StatsText" Text="鱼：未识别　　确认收获：0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
<TextBlock x:Name="InventoryText" Text="鱼背包：尚未读取" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SaleText" Text="尚未自动出售" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"/>
<TextBlock x:Name="BaitText" Text="鱼饵：尚未读取" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="BaitStatusText" Text="增益到期后，在抛竿前补用一份鱼饵。" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"/>
<TextBlock x:Name="MapText" Text="地图倒计时：尚未读取" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"/>
<TextBlock Text="实时蓄力" Margin="0,16,0,6"/>
<ProgressBar x:Name="GaugeBar" Minimum="0" Maximum="100" Height="8" Foreground="{StaticResource PrimaryBrush}"/><TextBlock x:Name="GaugeText" Text="0%" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"/>
</StackPanel></Border>
<StackPanel Grid.Row="3"><TextBlock Text="钓鱼设置" FontWeight="SemiBold" Margin="0,0,0,12"/><WrapPanel>
<StackPanel Margin="0,0,24,12"><TextBlock Text="下一竿间隔（毫秒）"/><TextBox x:Name="IntervalBox" Text="1000" Width="180" Padding="8" HorizontalAlignment="Left" Margin="0,6,0,0" LostFocus="SettingsChanged"/></StackPanel>
<StackPanel Margin="0,0,24,12"><TextBlock Text="抛竿蓄力（5–95%）"/><TextBox x:Name="CastBox" Text="90" Width="170" Padding="8" HorizontalAlignment="Left" Margin="0,6,0,0" LostFocus="SettingsChanged"/></StackPanel>
</WrapPanel><CheckBox x:Name="WeakBox" Content="优先弱点，来不及时使用普通命中" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged" Margin="0,0,0,12"/><CheckBox x:Name="AutoSellBox" Content="背包满自动出售" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged" Margin="0,0,0,8"/><CheckBox x:Name="KeepLegendaryBox" Content="保留全部传说鱼" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged" Margin="0,0,0,8"/>
<CheckBox x:Name="KeepLockedBox" Content="保留全部锁定鱼" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged" Margin="0,0,0,8"/>
<TextBlock Text="取消保留锁定鱼后，仅对选中的待售鱼先解锁，确认成功后再出售。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
<CheckBox x:Name="KeepUnknownBox" Content="保留资料不明的鱼" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged" Margin="0,0,0,8"/>
<TextBlock Text="取消后仍需满足游戏出售条件；库存 ID、出售条目无效或无法判断其他保留规则时会跳过。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
<Expander Header="按鱼种保留尺寸纪录" IsExpanded="True" Margin="0,0,0,16"><StackPanel Margin="0,10,0,0">
<TextBlock Text="尺寸规则额外保留鱼，不覆盖上方的全部保留选项。要仅保留极值，请取消对应的全部保留。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
<WrapPanel><CheckBox x:Name="SizeLegendaryBox" Content="应用于传说鱼" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged" Margin="0,0,20,8"/><CheckBox x:Name="SizeLockedBox" Content="应用于锁定鱼" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged" Margin="0,0,0,8"/></WrapPanel>
<WrapPanel><StackPanel Margin="0,0,12,8"><TextBlock Text="鱼种"/><ComboBox x:Name="SpeciesBox" Width="230" Margin="0,4,0,0" SelectionChanged="SpeciesChanged"/></StackPanel><StackPanel Margin="0,0,0,8"><TextBlock Text="额外保留"/><ComboBox x:Name="SizeModeBox" Width="160" Margin="0,4,0,0" SelectionChanged="SizeModeChanged"/></StackPanel></WrapPanel>
<TextBlock x:Name="SpeciesHint" Text="连接后读取背包鱼种。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
<TextBlock Text="按当前背包的同种鱼比较；并列保留一条，最大和最小相同时只保留一条。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
</StackPanel></Expander><CheckBox x:Name="AutoBaitBox" Content="自动使用鱼饵（增益到期后补用一份）" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged" Margin="0,0,0,8"/><TextBlock Text="消耗现有鱼饵；用完后继续普通钓鱼。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/><CheckBox x:Name="AutoMapBox" Content="到期前自动往返换图" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged" Margin="0,0,0,8"/><TextBlock Text="剩余 5 分钟时完成本竿，返回钓鱼大厅，再回原钓场继续。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/><TextBlock x:Name="SettingsHint" Text="设置即时保存；收线和长按按帧判断，不使用下一竿间隔。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/></StackPanel>
<Separator Grid.Row="4" Margin="0,18,0,14"/>
<StackPanel Grid.Row="5"><TextBlock x:Name="NetworkText" Text="网络：尚未连接" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ActionText" Text="操作：尚未开始" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="试用范围：当前钓点连续钓鱼。背包只剩保留鱼时等待整理；不自动购买补给或解锁地图。" TextWrapping="Wrap" Margin="0,14,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel>
</Grid></ScrollViewer></Window>
